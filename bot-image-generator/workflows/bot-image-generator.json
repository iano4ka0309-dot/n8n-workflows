    {
      "parameters": {
        "jsCode": "const text = $json.message?.text || '';\n\n// варіанти написання: латиниця, українська «і», російська «и»\nconst instaPattern = 'insta|інста|инста';\nconst fbPattern = 'fb|фб';\n\n// \"не літера й не цифра\" з обох боків = окреме слово (працює і для кирилиці)\nconst wrap = (p) => `(?<![\\\\p{L}\\\\p{N}])(${p})(?![\\\\p{L}\\\\p{N}])`;\n\nconst instaRe = new RegExp(wrap(instaPattern), 'iu');\nconst fbRe = new RegExp(wrap(fbPattern), 'iu');\nconst stripRe = new RegExp(wrap(`${instaPattern}|${fbPattern}`), 'giu');\n\nlet route = 'help';\nlet size = null;\n\nif (instaRe.test(text)) {\n  route = 'insta';\n  size = '1024x1536';\n} else if (fbRe.test(text)) {\n  route = 'fb';\n  size = '1536x1024';\n}\n\nconst prompt = text.replace(stripRe, '').trim();\n\nif (route !== 'help' && !prompt) {\n  route = 'help';\n  size = null;\n}\n\nreturn {\n  json: { route, size, prompt, chatId: $json.message.chat.id }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -672,
        -432
      ],
      "id": "103f86aa-6efd-4f17-8cde-f91ae40db223",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "chatId": "={{ $json.chatId }}",
        "text": "=Привіт! Я генерую картинки для соцмереж 🎨  Напиши команду і опис того, що намалювати:  - insta + опис → вертикальне зображення для Instagram - fb + опис → горизонтальний банер для Facebook  Приклади: insta кава в мінімалізмі fb банер про CRM  Команду без опису я не прийму, тож не забудь описати картинку.",
        "additionalFields": {
