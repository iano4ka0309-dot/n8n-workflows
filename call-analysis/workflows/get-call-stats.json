    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all()\n  .map(item => item.json)\n  .filter(row => row.sentiment); // відсіює порожній елемент, якщо дзвінків за період немає\n\nconst totalCalls = rows.length;\nconst negativeCalls = rows.filter(row => row.sentiment === 'negative').length;\nconst negativeCallPercent = totalCalls === 0\n  ? 0\n  : Math.round((negativeCalls / totalCalls) * 100);\n\nreturn [{\n  json: {\n    totalCalls,\n    negativeCalls,\n    negativeCallPercent: negativeCallPercent + '%'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
